{
  "name": "cistamp",
  "version": "0.1.0",
  "description": "Local CI receipt generator for reproducible command evidence.",
  "type": "module",
  "bin": {
    "cistamp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "ci",
    "receipt",
    "evidence",
    "verification",
    "local-first",
    "agent-tools"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/cistamp.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/cistamp/issues"
  },
  "homepage": "https://github.com/rogerchappel/cistamp#readme"
}
